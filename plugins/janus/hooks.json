{
  "janus": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"./hooks/secret-safety.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"./hooks/evidence-shell.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "write_to_file|write_file|replace_file_content|edit_file|multi_replace_file_content|notebook_edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"./hooks/evidence-lock.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "write_to_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"./hooks/findings-truncation.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "write_to_file|write_file|replace_file_content|edit_file|multi_replace_file_content|notebook_edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"./hooks/evidence-drift.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|write_file|replace_file_content|edit_file|multi_replace_file_content|notebook_edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"./hooks/evidence-chain.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
